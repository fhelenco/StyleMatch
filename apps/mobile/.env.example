# Supabase — Project Settings → API (the public anon key, safe for a client app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The backend's address, reachable from wherever you're running the app.
# - Web preview: http://localhost:3001 usually works.
# - Physical device (Expo Go): must be your computer's LAN IP, not localhost
#   — e.g. http://192.168.1.23:3001. Find it with `ipconfig getifaddr en0`
#   (macOS) and update this whenever it changes (Wi-Fi reconnects, etc).
EXPO_PUBLIC_API_URL=http://localhost:3001
