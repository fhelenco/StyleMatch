# Server
PORT=3001
# Comma-separated list of origins allowed to call this API (e.g. your Expo web
# preview and any deployed frontend). No trailing slashes.
ALLOWED_ORIGINS=http://localhost:8081

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
# ⚠️ Service role key — server-side only, bypasses Row Level Security. Never
# expose this to a client app.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
